{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StigNorland/lean-LLM-harness/schemas/method-release.schema.json",
  "title": "MethodRelease",
  "description": "Sealed method version consumed by programmes via pin.",
  "type": "object",
  "required": [
    "version",
    "date",
    "method_document",
    "technique_ids",
    "commitments_summary"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "method_document": {
      "type": "string",
      "description": "Path to living paper at seal time (usually METHOD.md)."
    },
    "technique_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T-[0-9]{3}$"
      },
      "description": "Adopted/adapted/originated-here techniques in this seal."
    },
    "commitments_summary": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "changelog_ref": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
